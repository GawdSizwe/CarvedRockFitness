<!DOCTYPE html>
<html lang="en" style="color-scheme: dark light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>@ViewData["Title"] — Sport &amp; Health Meetups SA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/gym-auth.css" asp-append-version="true" />
    <style>body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; }</style>
</head>
<body class="gym-auth-body">
    <div class="auth-header text-center py-5">
        <a href="/Account/Login" class="text-decoration-none auth-brand-link">
            <div class="auth-logo-mark mx-auto mb-3">
                <i class="bi bi-activity"></i>
            </div>
            <div class="fw-black text-white auth-wordmark">SPORT<span class="text-orange">&amp;HEALTH</span></div>
            <div class="auth-tagline">SA's Sport &amp; Fitness Ad Board</div>
        </a>
    </div>
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>
    <div class="auth-footer text-center pb-4">
        <span class="text-muted" style="font-size:.75rem">&copy; @DateTime.Now.Year Sport &amp; Health Meetups SA &mdash; Powered by ASP.NET Core &amp; OpenIddict</span>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
