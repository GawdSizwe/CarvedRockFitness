<!DOCTYPE html>
<html lang="en" style="color-scheme: dark light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>@ViewData["Title"] — Sport &amp; Health Meetups SA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/gym.css" asp-append-version="true" />
    <style>body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; }</style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="gym-body"
      data-toast-success="@TempData["Success"]"
      data-toast-error="@TempData["Error"]">

    <!-- Top progress bar -->
    <div id="gym-progress"></div>

    <!-- Full-page loader -->
    <div id="gym-page-loader" role="status" aria-live="polite">
        <div class="gym-spinner"></div>
        <p id="gym-loader-msg">Loading…</p>
    </div>

    <!-- Toast container -->
    <div id="gym-toast-container" aria-live="polite"></div>

    <nav class="navbar navbar-expand-lg gym-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand gym-brand" asp-controller="Home" asp-action="Index">
                SPORT<span class="text-orange">&amp;HEALTH</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#gymNav"
                    aria-controls="gymNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list text-white fs-4"></i>
            </button>
            <div class="collapse navbar-collapse" id="gymNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link gym-nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-fill me-1"></i>Feed
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("PaidUser") || User.IsInRole("Admin")))
                    {
                        <li class="nav-item">
                            <a class="nav-link gym-nav-link" asp-controller="Suggestion" asp-action="Create">
                                <i class="bi bi-plus-circle-fill me-1"></i>Post Listing
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link gym-nav-link" asp-controller="Academy" asp-action="Index">
                            <i class="bi bi-shield-fill-check me-1"></i>YVEDA Academy
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link gym-nav-link" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-fill me-1"></i>Admin
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link gym-nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark gym-dropdown">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                                @if (!User.IsInRole("PaidUser") && !User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item text-orange" asp-controller="Payment" asp-action="Checkout"><i class="bi bi-lightning-fill me-2"></i>Upgrade to Premium</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-gym-outline btn-sm me-2" asp-controller="Account" asp-action="Login">Sign In</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @if (TempData["PaymentSuccess"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["PaymentSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["PaymentCancelled"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle-fill me-2"></i>@TempData["PaymentCancelled"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ApiWarning"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-warning alert-dismissible fade show d-flex align-items-start gap-3" role="alert">
                    <i class="bi bi-tools flex-shrink-0 mt-1" style="font-size:1.2rem"></i>
                    <div class="flex-grow-1">
                        <strong>Temporary issue</strong> — @TempData["ApiWarning"]
                        <div class="d-flex flex-wrap gap-3 mt-2" style="font-size:.85rem">
                            <a href="/" class="text-dark fw-semibold"><i class="bi bi-arrow-clockwise me-1"></i>Try again</a>
                            <a href="mailto:support@sportmeetups.co.za?subject=Feed+Error" class="text-dark fw-semibold"><i class="bi bi-envelope me-1"></i>Contact support</a>
                            <a href="https://wa.me/27000000000?text=Hi+I'm+experiencing+an+issue+on+Sport+%26+Health+Meetups+SA" class="text-dark fw-semibold"><i class="bi bi-whatsapp me-1"></i>WhatsApp us</a>
                        </div>
                    </div>
                    <button type="button" class="btn-close flex-shrink-0" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="gym-footer mt-5 py-5">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-md-5">
                    <span class="gym-brand fs-6">SPORT<span class="text-orange">&amp;HEALTH</span></span>
                    <p class="text-muted small mt-2 mb-0">South Africa's sport &amp; fitness ad board. Football, gym, running &amp; more — near you.</p>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="gym-footer-link">Feed</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Account" asp-action="Profile" class="gym-footer-link">Profile</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="gym-footer-link">Sign In</a>
                        }
                    </div>
                </div>
                <div class="col-md-3 text-md-end">
                    <p class="text-muted small mb-0">&copy; @DateTime.Now.Year Sport &amp; Health Meetups SA</p>
                    <p class="text-muted" style="font-size:0.7rem">Built with ASP.NET Core &amp; OpenIddict</p>
                </div>
            </div>
        </div>
    </footer>

    <nav class="gym-bottom-nav" aria-label="Mobile navigation">
        <a asp-controller="Home" asp-action="Index">
            <i class="bi bi-grid-fill"></i>Feed
        </a>
        <a asp-controller="Academy" asp-action="Index">
            <i class="bi bi-shield-fill-check"></i>Academy
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index">
                <i class="bi bi-shield-fill"></i>Admin
            </a>
        }
        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("PaidUser") || User.IsInRole("Admin")))
        {
            <a asp-controller="Suggestion" asp-action="Create" class="gym-bottom-post">
                <i class="bi bi-plus-lg"></i>Post
            </a>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Payment" asp-action="Checkout" class="gym-bottom-post">
                <i class="bi bi-lightning-fill"></i>Upgrade
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="gym-bottom-post">
                <i class="bi bi-plus-lg"></i>Join
            </a>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Account" asp-action="Profile">
                <i class="bi bi-person-circle"></i>Profile
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">
                <i class="bi bi-box-arrow-in-right"></i>Sign In
            </a>
        }
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    (function () {
        /* ── Progress bar ── */
        var bar = document.getElementById('gym-progress');
        var barTimer, barVal = 0;
        function progressStart() {
            bar.style.opacity = '1';
            bar.classList.remove('gym-progress-done');
            barVal = 0;
            bar.style.width = '0%';
            barTimer = setInterval(function () {
                if (barVal < 85) { barVal += (85 - barVal) * 0.08 + 0.5; bar.style.width = barVal + '%'; }
            }, 80);
        }
        function progressDone() {
            clearInterval(barTimer);
            bar.style.width = '100%';
            setTimeout(function () { bar.classList.add('gym-progress-done'); }, 300);
        }

        /* ── Page loader ── */
        var loader = document.getElementById('gym-page-loader');
        var loaderMsg = document.getElementById('gym-loader-msg');
        function showLoader(msg) {
            loaderMsg.textContent = msg || 'Loading…';
            loader.classList.add('active');
            progressStart();
        }
        function hideLoader() {
            loader.classList.remove('active');
            progressDone();
        }

        /* ── Toast ── */
        var toastBox = document.getElementById('gym-toast-container');
        function showToast(msg, type) {
            var icons = { success: 'bi-check-circle-fill', error: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
            var colors = { success: '#22c55e', error: '#ef4444', info: 'var(--gym-orange)' };
            var t = document.createElement('div');
            t.className = 'gym-toast ' + (type || 'info');
            t.innerHTML = '<i class="bi ' + (icons[type] || icons.info) + '" style="color:' + (colors[type] || colors.info) + ';font-size:1.1rem"></i><span>' + msg + '</span>';
            toastBox.appendChild(t);
            setTimeout(function () { t.classList.add('hiding'); setTimeout(function () { t.remove(); }, 300); }, 3500);
        }
        window.gymToast = showToast;

        /* ── Nav links: progress bar on click ── */
        document.querySelectorAll('a:not([data-no-loader]):not([href^="#"]):not([href^="mailto"]):not([href^="tel"]):not([target="_blank"])').forEach(function (a) {
            a.addEventListener('click', function (e) {
                var href = this.getAttribute('href');
                if (!href || href === '#' || href === window.location.href || href === window.location.pathname) return;
                if (e.ctrlKey || e.metaKey || e.shiftKey) return;
                // Don't trigger loader for Bootstrap dropdown toggles
                if (this.getAttribute('data-bs-toggle') === 'dropdown') return;
                progressStart();
            });
        });

        /* ── Forms: spinner on submit ── */
        document.querySelectorAll('form:not([data-no-loader])').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) return;
                var btn = form.querySelector('[type="submit"]');
                if (btn) {
                    var original = btn.innerHTML;
                    btn.dataset.original = original;
                    btn.innerHTML = '<span class="btn-text">' + original + '</span>';
                    btn.classList.add('btn-gym-loading');
                }
                var msg = form.dataset.loadingMsg || 'Saving…';
                showLoader(msg);
            });
        });

        /* ── Hide loader on page show (back/forward cache) ── */
        window.addEventListener('pageshow', function (e) {
            hideLoader();
            document.querySelectorAll('.btn-gym-loading').forEach(function (b) {
                b.classList.remove('btn-gym-loading');
                if (b.dataset.original) b.innerHTML = b.dataset.original;
            });
        });

        /* ── Show TempData toasts ── */
        var successMsg = document.body.dataset.toastSuccess;
        var errorMsg   = document.body.dataset.toastError;
        if (successMsg) { setTimeout(function() { showToast(successMsg, 'success'); }, 300); }
        if (errorMsg)   { setTimeout(function() { showToast(errorMsg,   'error');   }, 300); }

        /* ── Hamburger toggler ── */
        var toggler = document.querySelector('.navbar-toggler');
        var navCollapse = document.querySelector('#gymNav');
        if (toggler && navCollapse) {
            toggler.addEventListener('click', function () {
                var expanded = this.getAttribute('aria-expanded') === 'true';
                this.setAttribute('aria-expanded', String(!expanded));
                navCollapse.classList.toggle('show');
            });
            // Only close the collapse when a real navigation link is clicked,
            // NOT dropdown toggles (they need the collapse to stay open)
            navCollapse.querySelectorAll('a').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (this.getAttribute('data-bs-toggle') === 'dropdown') return;
                    // Also don't close if this link is inside an open dropdown menu
                    if (this.closest('.dropdown-menu')) return;
                    navCollapse.classList.remove('show');
                    toggler.setAttribute('aria-expanded', 'false');
                });
            });
        }

        /* ── Active bottom nav ── */
        var path = window.location.pathname.toLowerCase();
        document.querySelectorAll('.gym-bottom-nav a').forEach(function (a) {
            var href = (a.getAttribute('href') || '').toLowerCase();
            if (href && href !== '/' && path.startsWith(href)) a.classList.add('active');
            else if (href === '/' && (path === '/' || path === '')) a.classList.add('active');
        });

        /* ── Progress done when page finishes loading ── */
        if (document.readyState === 'complete') { progressDone(); }
        else { progressStart(); window.addEventListener('load', progressDone); }
    })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
