@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-xl-4 text-center">
            <div class="gym-empty-icon mx-auto mb-4" style="width:90px;height:90px;font-size:2.5rem">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h2 class="fw-bold mb-2" style="color:var(--text-1)">Access Denied</h2>
            <p class="text-muted mb-4">
                You don't have permission to view this page.<br>
                This area requires a higher access level.
            </p>
            <div class="d-flex flex-column gap-2 align-items-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-gym">
                    <i class="bi bi-house-fill"></i>Back to Feed
                </a>
                @if (User.IsInRole("FreeUser") || (!User.IsInRole("Admin") && !User.IsInRole("PaidUser")))
                {
                    <a asp-controller="Payment" asp-action="Checkout" class="btn btn-gym-dark">
                        <i class="bi bi-lightning-fill"></i>Upgrade to Premium
                    </a>
                }
            </div>
            <p class="text-muted mt-4" style="font-size:.78rem">
                If you believe this is an error, please contact support.
            </p>
        </div>
    </div>
</div>
